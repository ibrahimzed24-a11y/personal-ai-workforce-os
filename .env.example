# Personal AI Workforce OS — Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials to Git)

# OS Runtime Port & Host Binding (Localhost only)
AI_WORKFORCE_HOST=127.0.0.1
AI_WORKFORCE_PORT=8765

# Optional Vault Master Key Override (Defaults to ~/.ai_workforce_vault.key)
# AI_WORKFORCE_VAULT_KEY=your-fernet-master-key-here

# Optional Local Ollama Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud Model API Keys (Recommended: Configure securely via Web Dashboard Vault)
# OPENAI_API_KEY=sk-placeholder-openai-key
# GEMINI_API_KEY=placeholder-gemini-key
# ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key

# Logging Level
LOG_LEVEL=INFO
